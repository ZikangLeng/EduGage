<Page
    x:Class="MSBandStreamer.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MSBandStreamer"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
                <TextBlock Text="IP Address:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox x:Name="IpAddressInput" Text="192.168.1.100" Width="150" Margin="0,0,20,0"/>
                
                <TextBlock Text="Port:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox x:Name="PortInput" Text="9898" Width="80"/>
            </StackPanel>

            <Button x:Name="ConnectButton" Content="Connect &amp; Stream" Click="ConnectButton_Click" HorizontalAlignment="Center" Margin="10,20,10,30" FontSize="18"/>

            <TextBlock x:Name="StatusText" Text="Waiting for connection parameters..." FontSize="18" Margin="10" HorizontalAlignment="Center"/>
            <TextBlock x:Name="GSRDisplay" Text="Latest GSR Resistance: ---" FontSize="24" FontWeight="Bold" Margin="10" HorizontalAlignment="Center"/>
            <TextBlock x:Name="HRDisplay" Text="Latest Heart Rate: ---" FontSize="24" FontWeight="Bold" Margin="10" HorizontalAlignment="Center"/>
            
        </StackPanel>
    </Grid>
</Page>
